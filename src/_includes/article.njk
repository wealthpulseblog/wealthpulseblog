---
layout: base.njk
og_type: article
schemaType: Article
---

<main class="container article-page">
  <article>
    <p class="article-category">{{ niche | replace("-", " ") | title }}</p>
    <h1>{{ title }}</h1>
    <p class="article-meta">Published: {{ date | readableDate }}</p>

    {% if intent == "affiliate" %}
    <p class="article-meta"><em>This article contains affiliate links. We may earn a commission at no extra cost to you.</em></p>
    {% endif %}

    {{ content | safe }}
  </article>
</main>
