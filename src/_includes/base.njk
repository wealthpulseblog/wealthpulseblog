<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title and title != false %}{{ title }} | {{ settings.site_name }}{% else %}{{ settings.site_name }}{% endif %}</title>
  <meta name="description" content="{{ description or settings.tagline }}" />
  <link rel="canonical" href="{{ settings.site_url }}{{ page.url }}" />
  <link rel="stylesheet" href="/assets/style.css" />
  <link rel="stylesheet" href="/assets/product-cards.css" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">{{ settings.site_name }}</a>
      <nav>
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/privacy/">Privacy</a>
        <a href="/admin/">Admin</a>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="container">
      <p>&copy; <span id="year"></span> {{ settings.site_name }}. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();

    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
