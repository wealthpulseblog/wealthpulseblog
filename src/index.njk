---
layout: base.njk
title: false
description: "Product reviews, comparisons and buying guides."
permalink: /
---

{% set latest = collections.articles | slice(0,6) %}

<main>

<section class="homepage-intro">

  <div class="container">

    <h2 class="section-title">
      Trusted Buying Guides
    </h2>

    <p class="section-copy">
      We help shoppers discover products worth buying.
      Our reviews, comparisons and buying guides focus
      on helping you make smarter purchasing decisions.
    </p>

  </div>

</section>

<section class="categories">

  <div class="container">

    <h2 class="section-title">
      Popular Categories
    </h2>

    <div class="category-grid">

      <div class="category-card">
        <h3>💻 Tech & Gadgets</h3>
        <p>Headphones, accessories, electronics and smart devices.</p>
      </div>

      <div class="category-card">
        <h3>🏠 Home & Kitchen</h3>
        <p>Appliances, storage solutions and useful household products.</p>
      </div>

      <div class="category-card">
        <h3>🏃 Fitness</h3>
        <p>Fitness trackers, wellness products and exercise gear.</p>
      </div>

      <div class="category-card">
        <h3>🔥 Deals & Discoveries</h3>
        <p>Interesting finds from Amazon, Temu and other retailers.</p>
      </div>

    </div>

  </div>

</section>

<section class="trust-section">

  <div class="container">

    <div class="trust-grid">

      <div class="trust-card">
        <h3>Reviews</h3>
        <p>In-depth analysis of products worth considering.</p>
      </div>

      <div class="trust-card">
        <h3>Comparisons</h3>
        <p>Side-by-side evaluations to help you choose faster.</p>
      </div>

      <div class="trust-card">
        <h3>Buying Guides</h3>
        <p>Curated recommendations for every budget.</p>
      </div>

    </div>

  </div>

</section>

<section id="latest" class="latest-reviews">

  <div class="container">

    <h2 class="section-title">
      Latest Reviews & Guides
    </h2>

    <div class="review-grid">

      {% for article in latest %}

      <article class="review-card">

        <span class="card-category">
          {{ article.data.niche | replace("-", " ") | title }}
        </span>

        <h3>
          <a href="{{ article.url }}">
            {{ article.data.title }}
          </a>
        </h3>

        <p>
          {{ article.data.description }}
        </p>

        <a class="read-more" href="{{ article.url }}">
          Read Review →
        </a>

      </article>

      {% endfor %}

    </div>

  </div>

</section>

</main>
