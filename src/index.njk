---
layout: base.njk
title: false
description: "Practical advice on money, health, productivity and career growth."
permalink: /
---

{% set articles = collections.articles or [] %}
{% set heroArticle = collections.featured[0] or articles[0] %}

<main class="container">
  {% if heroArticle %}
  <section class="home-featured">
    <p class="article-category">{{ heroArticle.data.niche | replace("-", " ") | title }}</p>
    <h1><a href="{{ heroArticle.url }}">{{ heroArticle.data.title }}</a></h1>
    <p class="article-meta">Published: {{ heroArticle.date | readableDate }}</p>
    <p>{{ heroArticle.data.description }}</p>
    <p><a href="{{ heroArticle.url }}">Read Article</a></p>
  </section>
  {% endif %}

  {% if articles.length > 1 %}
  <section class="home-list">
    <h2>Latest Articles</h2>
    {% for article in articles %}
      {% if not heroArticle or article.url != heroArticle.url %}
      <article class="post-card">
        <p class="article-category">{{ article.data.niche | replace("-", " ") | title }}</p>
        <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
        <p class="article-meta">Published: {{ article.date | readableDate }}</p>
        <p>{{ article.data.description }}</p>
      </article>
      {% endif %}
    {% endfor %}
  </section>
  {% endif %}
</main>
