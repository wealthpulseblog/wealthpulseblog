description: "Honest product reviews, buying guides and comparisons."
permalink: /
---

{% set latest = collections.articles | slice(0,6) %}

<main>

<section class="hero">
  <div class="hero-inner">

    <span class="hero-badge">
      Product Reviews & Buying Guides
    </span>

    <h1>
      Find Products Worth Your Money
    </h1>

    <p>
      We research, compare and review products from Amazon,
      Temu and other online marketplaces so you can buy with
      confidence.
    </p>

    <div class="hero-actions">
      #latest
        Browse Reviews
      </a>

      <a href="/about/" class="btn btn-secondary">
        Learn More
      </a>
    </div>

  </div>
</section>

<section class="categories">

  <h2>Browse Categories</h2>

  <div class="category-grid">

    <div class="category-card">
      <h3>💻 Tech & Gadgets</h3>
      <p>Laptops, accessories, headphones and electronics.</p>
    </div>

    <div class="category-card">
      <h3>🏠 Home & Kitchen</h3>
      <p>Appliances, storage solutions and cooking products.</p>
    </div>

    <div class="category-card">
      <h3>🏃 Health & Fitness</h3>
      <p>Fitness trackers, equipment and wellness products.</p>
    </div>

    <div class="category-card">
      <h3>🔥 Best Deals</h3>
      <p>Curated discoveries from Amazon and Temu.</p>
    </div>

  </div>

</section>

<section class="featured-section">

  <h2>What You'll Find Here</h2>

  <div class="feature-grid">

    <div class="feature-box">
      <h3>Best Product Lists</h3>
      <p>Ranked buying guides based on research and comparison.</p>
    </div>

    <div class="feature-box">
      <h3>Detailed Reviews</h3>
      <p>Pros, cons, ratings and real recommendations.</p>
    </div>

    <div class="feature-box">
      <h3>Comparison Guides</h3>
      <p>Side-by-side comparisons to help you choose faster.</p>
    </div>

  </div>

</section>

<section id="latest" class="latest-reviews">

<h2>Latest Reviews & Guides</h2>

<div class="review-grid">

{% for article in latest %}

<article class="review-card">

  <span class="card-category">
    {{ article.data.niche | replace("-", " ") | title }}
  </span>

  <h3>
    {{ article.url }}
      {{ article.data.title }}
    </a>
  </h3>

  <p>
    {{ article.data.description }}
  </p>

  {{ article.url }}
    Read Review →
  </a>

</article>

{% endfor %}

</div>

</section>

</main>
