---
layout: base.njk
title: false
description: "WealthPulse — practical, no-fluff advice on personal finance, health, productivity, and career growth."
permalink: /
---

{% set articles = collections.articles or [] %}
{% set heroArticle = collections.featured[0] or articles[0] %}

{% if heroArticle %}
<section class="hero-section">
  <span class="section-label">Editor's Pick</span>
  <div class="hero-article">
    <div class="hero-img">
      <div class="hero-img-inner">
        {% if heroArticle.data.niche == "personal-finance" %}💰
        {% elif heroArticle.data.niche == "health-fitness" %}💪
        {% elif heroArticle.data.niche == "productivity" %}⚡
        {% elif heroArticle.data.niche == "career-growth" %}📈
        {% else %}🏡{% endif %}
      </div>
    </div>
    <div>
      <div class="hero-niche">
        {{ heroArticle.data.niche | replace("-", " ") | title }}
      </div>
      <h1 class="hero-title">
        <a href="{{ heroArticle.url }}">{{ heroArticle.data.title }}</a>
      </h1>
      <p class="hero-excerpt">{{ heroArticle.data.description }}</p>
      <a href="{{ heroArticle.url }}" class="read-more">Read Article</a>
    </div>
  </div>
</section>
{% endif %}

{% if articles.length %}
<section class="articles-section">
  <span class="section-label">Latest</span>
  <div class="articles-grid">
    {% for article in articles %}
      {% if not heroArticle or article.url != heroArticle.url %}
      <div class="article-card">
        <div class="card-niche">
          {{ article.data.niche | replace("-", " ") | title }}
        </div>
        <h2 class="card-title">
          <a href="{{ article.url }}">{{ article.data.title }}</a>
        </h2>
        <p class="card-excerpt">{{ article.data.description }}</p>
      </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}
